diff --git a/package/contents/ui/configCalendar.qml b/package/contents/ui/configCalendar.qml
new file mode 100644
index 0000000..bc57711
--- /dev/null
+++ b/package/contents/ui/configCalendar.qml
@@ -0,0 +1,154 @@
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kcmutils as KCMUtils
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.plasmoid
+import org.kde.plasma.workspace.calendar as PlasmaCalendar
+
+KCMUtils.ScrollViewKCM {
+    id: calendarPage
+
+    property alias cfg_showWeekNumbers: showWeekNumbers.checked
+    property int cfg_firstDayOfWeek
+    property bool unsavedChanges: false
+    property bool initialized: false
+    property bool savedShowWeekNumbers: false
+    property int savedFirstDayOfWeek: -1
+    property var savedEnabledPlugins: []
+
+    extraFooterTopPadding: true
+
+    function normalizePluginList(plugins) {
+        return Array.from(plugins || []).sort();
+    }
+
+    function pluginListsEqual(left, right) {
+        const normalizedLeft = normalizePluginList(left);
+        const normalizedRight = normalizePluginList(right);
+
+        return normalizedLeft.length === normalizedRight.length
+            && normalizedLeft.every((entry, index) => entry === normalizedRight[index]);
+    }
+
+    function comboIndexForDay(day) {
+        return firstDayOfWeekCombo.model.findIndex(item => item.day === day);
+    }
+
+    function rememberSavedState() {
+        savedShowWeekNumbers = Boolean(Plasmoid.configuration.showWeekNumbers);
+        savedFirstDayOfWeek = Number(Plasmoid.configuration.firstDayOfWeek);
+        savedEnabledPlugins = normalizePluginList(Plasmoid.configuration.enabledCalendarPlugins);
+    }
+
+    function syncUiFromConfig() {
+        rememberSavedState();
+
+        showWeekNumbers.checked = savedShowWeekNumbers;
+        cfg_firstDayOfWeek = savedFirstDayOfWeek;
+        firstDayOfWeekCombo.currentIndex = comboIndexForDay(cfg_firstDayOfWeek);
+        eventPluginsManager.populateEnabledPluginsList(savedEnabledPlugins);
+    }
+
+    function checkUnsavedChanges() {
+        if (!initialized) {
+            return;
+        }
+
+        unsavedChanges = showWeekNumbers.checked !== savedShowWeekNumbers
+            || cfg_firstDayOfWeek !== savedFirstDayOfWeek
+            || !pluginListsEqual(eventPluginsManager.enabledPlugins, savedEnabledPlugins);
+    }
+
+    function saveConfig() {
+        Plasmoid.configuration.showWeekNumbers = showWeekNumbers.checked;
+        Plasmoid.configuration.firstDayOfWeek = cfg_firstDayOfWeek;
+        Plasmoid.configuration.enabledCalendarPlugins = eventPluginsManager.enabledPlugins;
+        Plasmoid.configuration.writeConfig();
+        rememberSavedState();
+        unsavedChanges = false;
+    }
+
+    Component.onCompleted: {
+        syncUiFromConfig();
+        initialized = true;
+    }
+
+    header: Kirigami.FormLayout {
+        PlasmaCalendar.EventPluginsManager {
+            id: eventPluginsManager
+        }
+
+        QQC2.CheckBox {
+            id: showWeekNumbers
+            Kirigami.FormData.label: i18nc("@option:check formdata label", "General:")
+            text: i18nc("@option:check", "Show week numbers")
+            onToggled: calendarPage.checkUnsavedChanges()
+        }
+
+        QQC2.ComboBox {
+            id: firstDayOfWeekCombo
+
+            Kirigami.FormData.label: i18nc("@label:listbox", "First day of week:")
+            Layout.fillWidth: true
+
+            textRole: "text"
+            model: [-1, 0, 1, 5, 6].map(day => ({
+                day,
+                text: day === -1 ? i18nc("@item:inlistbox first day of week option", "Use region defaults") : Qt.locale().dayName(day),
+            }))
+            currentIndex: model.findIndex(item => item.day === calendarPage.cfg_firstDayOfWeek)
+
+            onActivated: index => {
+                cfg_firstDayOfWeek = model[index].day;
+                calendarPage.checkUnsavedChanges();
+            }
+        }
+
+        Item {
+            Kirigami.FormData.isSection: true
+        }
+    }
+
+    view: ListView {
+        id: pluginListView
+        activeFocusOnTab: true
+        model: eventPluginsManager.model
+        header: Kirigami.InlineViewHeader {
+            text: i18nc("@title:column", "Available Add-Ons")
+            width: pluginListView.width
+        }
+        headerPositioning: ListView.OverlayHeader
+
+        delegate: QQC2.CheckDelegate {
+            id: delegate
+
+            required property var model
+
+            width: pluginListView.width
+            checked: model.checked
+            text: model.display
+            property string subtitle: model.toolTip
+            icon.source: model.decoration
+
+            Accessible.onPressAction: {
+                toggle();
+                clicked();
+            }
+
+            onClicked: {
+                model.checked = checked;
+                calendarPage.checkUnsavedChanges();
+            }
+
+            contentItem: Kirigami.IconTitleSubtitle {
+                width: delegate.availableWidth
+                icon: icon.fromControlsIcon(delegate.icon)
+                title: delegate.text
+                subtitle: delegate.subtitle
+                selected: delegate.highlighted || delegate.pressed
+            }
+        }
+    }
+}
